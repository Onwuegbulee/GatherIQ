# GatherIQ Backend — Local Environment
# This file is NOT committed to version control.
# Copy from .env.example and customise for your environment.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gatheriq

# Generate a strong random secret for production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=gatheriq-secure-production-jwt-secret-key-32chars

JWT_ACCESS_MINUTES=15
REFRESH_REMEMBER_DAYS=30
REFRESH_SESSION_HOURS=12

# Allow both localhost and 127.0.0.1 origins from the Next.js dev server
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ALLOW_DEMO_COUNTS=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
MAX_BODY_BYTES=1048576
