# GatherIQ Backend — Environment Configuration Reference
# For local development, copy this file to .env and customize values.
# For Render deployment, configure these in the Render Dashboard under "Environment".

# Environment mode: 'development' or 'production'
# In production, GatherIQ strictly requires a PostgreSQL DATABASE_URL and rejects SQLite fallback.
ENVIRONMENT=development

# Database Connection URL
# Local development (SQLite fallback allowed in development only):
DATABASE_URL=sqlite:///./gatheriq.db
# Production (Render managed PostgreSQL or external PostgreSQL):
# Render automatically provides DATABASE_URL starting with postgres:// which GatherIQ normalizes.
# DATABASE_URL=postgresql+psycopg://gatheriq_user:your_password@dpg-xxxxxx-a.oregon-postgres.render.com/gatheriq_db

# Security & Authentication
# Required in production: must be at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-secure-random-32-character-secret-in-production
JWT_ACCESS_MINUTES=15
REFRESH_REMEMBER_DAYS=30
REFRESH_SESSION_HOURS=12

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcard '*').
# In production with Vercel and Render, set to your exact Vercel domain(s):
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Example production: CORS_ORIGINS=https://gatheriq.vercel.app,https://your-custom-domain.com

# Cookie Settings (Cross-Site Authentication: Vercel Frontend + Render Backend)
# In production, modern browsers strictly require COOKIE_SECURE=true and COOKIE_SAMESITE=none
# for cross-site HttpOnly refresh cookies to be sent from the Vercel domain to Render.
# In local development over HTTP, leave COOKIE_SECURE=false and COOKIE_SAMESITE=lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate Limiting
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# Super Admin Provisioning (Fresh Database Setup)
# If provided, GatherIQ automatically provisions the initial Super Admin account on first startup.
# Passwords are never hardcoded in production source code.
SUPER_ADMIN_EMAIL=superadmin@gatheriq.dev
SUPER_ADMIN_NAME=Platform Super Admin
# Set a strong password in Render environment variables:
# SUPER_ADMIN_PASSWORD=YourStrongSuperAdminPassword2026!

# Demonstration Mode
# Set to false in strict production environments
ALLOW_DEMO_COUNTS=false

# Port & Host (Set dynamically by Render via $PORT)
PORT=8000
HOST=0.0.0.0
