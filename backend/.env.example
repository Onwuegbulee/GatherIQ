# GatherIQ Backend Environment Configuration

# Database connection URL
# For local development with SQLite (default fallback):
DATABASE_URL=sqlite:///./gatheriq.db
# For production with PostgreSQL:
# DATABASE_URL=postgresql+psycopg://gatheriq:gatheriq@localhost:5432/gatheriq

# JWT Authentication
# Secret must be at least 32 characters in production:
JWT_SECRET=replace-with-a-secure-random-32-character-secret-in-production
JWT_ACCESS_MINUTES=15
REFRESH_REMEMBER_DAYS=30
REFRESH_SESSION_HOURS=12

# CORS Origins (comma-separated list of allowed web origins)
CORS_ORIGINS=http://localhost:3000

# Security & Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate Limiting (attempts per window)
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# Demonstration & Testing Modes
ALLOW_DEMO_COUNTS=true
